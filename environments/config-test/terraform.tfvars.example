proxmox_endpoint       = "https://192.0.2.10:8006/api2/json"
proxmox_api_token_file = "~/.config/platform-infrastructure/infra/proxmox.token"
proxmox_insecure       = false
proxmox_node           = "pve-example"

default_bridge               = "vmbr-example"
default_datastore            = "example-vm-storage"
default_cloud_init_datastore = "example-cloud-init-storage"
default_scsi_hardware        = "virtio-scsi-single"
default_disk_iothread        = true
default_disk_discard         = "on"
default_disk_cache           = "none"
default_disk_file_format     = "raw"
default_dns_servers          = ["192.0.2.53"]
default_dns_search_domain    = "example.test"
template_vm_id               = 9001

cloud_init_username = "rocky"
agent_enabled       = true
default_agent_trim  = false

vms = {
  example-config-test-01 = {
    vm_id       = 121
    hostname    = "example-config-test-01.example.test"
    description = "Disposable platform-config acceptance VM"
    tags        = ["rocky", "disposable"]

    cores     = 2
    cpu_type  = "host"
    memory_mb = 2048
    disk_gb   = 25

    additional_disks = [
      {
        interface = "scsi1"
        size_gb   = 32
        serial    = "config-test-data-01"
      }
    ]

    ipv4         = "192.0.2.121/24"
    ipv4_gateway = "192.0.2.1"
  }
}
