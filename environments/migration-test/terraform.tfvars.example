proxmox_endpoint       = "https://192.0.2.10:8006/api2/json"
proxmox_api_token_file = "~/.config/platform-infrastructure/infra/proxmox.token"
proxmox_insecure       = false
proxmox_node           = "pve"

default_bridge               = "vmbr0"
default_datastore            = "local-lvm"
default_cloud_init_datastore = "local-lvm"
default_scsi_hardware        = "virtio-scsi-single"
default_disk_iothread        = true
default_disk_discard         = "on"
default_disk_cache           = "none"
default_disk_file_format     = "raw"
default_dns_servers          = ["192.0.2.1"]
default_dns_search_domain    = "example.test"
template_vm_id               = 9001

# Per-VM cloud-init SSH keys are generated by make init-ssh.
cloud_init_username = "rocky"
agent_enabled       = true
default_agent_trim  = false

# All VM IDs, template IDs, addresses, and names below are fictional documentation values.
vms = {
  example-rocky-migration-10-0 = {
    vm_id          = 131
    hostname       = "example-rocky-migration-10-0.example.test"
    description    = "Disposable clean Rocky Linux 10.0 migration baseline VM"
    tags           = ["rocky", "disposable"]
    template_vm_id = 9000
    expected_version_id = "10.0"

    cores     = 2
    cpu_type  = "host"
    memory_mb = 2048
    disk_gb   = 20

    additional_disks = []

    ipv4         = "192.0.2.86/24"
    ipv4_gateway = "192.0.2.1"
  }

  example-rocky-migration-10-1 = {
    vm_id          = 132
    hostname       = "example-rocky-migration-10-1.example.test"
    description    = "Disposable clean Rocky Linux 10.1 migration baseline VM"
    tags           = ["rocky", "disposable"]
    template_vm_id = 9001
    expected_version_id = "10.1"

    cores     = 2
    cpu_type  = "host"
    memory_mb = 2048
    disk_gb   = 20

    additional_disks = []

    ipv4         = "192.0.2.87/24"
    ipv4_gateway = "192.0.2.1"
  }
}
